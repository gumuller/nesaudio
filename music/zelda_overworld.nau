# The Legend of Zelda - Overworld Theme
# Epic adventure theme by Koji Kondo
title: "The Legend of Zelda - Overworld Theme"
composer: "Koji Kondo"
tempo: 140
time_signature: "4/4"

channels:
  pulse1:
    enabled: true
    duty_cycle: 0.25
    volume: 0.85
    notes:
      # Opening fanfare: A#-F-A#-A#-C-D-D#
      - {time: 0.0, pitch: "A#4", duration: 0.4}
      - {time: 0.5, pitch: "F5", duration: 0.3}
      - {time: 0.8, pitch: "A#4", duration: 0.2}
      - {time: 1.0, pitch: "A#4", duration: 0.3}
      - {time: 1.3, pitch: "C5", duration: 0.2}
      - {time: 1.5, pitch: "D5", duration: 0.3}
      - {time: 1.8, pitch: "D#5", duration: 0.6}

      # Second phrase: D#-D#-E-F-F-F#-G#
      - {time: 2.5, pitch: "D#5", duration: 0.3}
      - {time: 2.8, pitch: "D#5", duration: 0.3}
      - {time: 3.1, pitch: "E5", duration: 0.2}
      - {time: 3.3, pitch: "F5", duration: 0.3}
      - {time: 3.6, pitch: "F5", duration: 0.3}
      - {time: 3.9, pitch: "F#5", duration: 0.2}
      - {time: 4.1, pitch: "G#5", duration: 0.6}

      # Main melody: A#-A#-A#-G#-A#
      - {time: 4.8, pitch: "A#4", duration: 0.8}
      - {time: 5.6, pitch: "A#4", duration: 0.3}
      - {time: 5.9, pitch: "A#4", duration: 0.3}
      - {time: 6.2, pitch: "G#4", duration: 0.3}
      - {time: 6.5, pitch: "A#4", duration: 0.6}

      # G-G-G-F-G
      - {time: 7.2, pitch: "G4", duration: 0.8}
      - {time: 8.0, pitch: "G4", duration: 0.3}
      - {time: 8.3, pitch: "G4", duration: 0.3}
      - {time: 8.6, pitch: "F4", duration: 0.3}
      - {time: 8.9, pitch: "G4", duration: 0.6}

      # F-F-F-E-F
      - {time: 9.6, pitch: "F4", duration: 0.8}
      - {time: 10.4, pitch: "F4", duration: 0.3}
      - {time: 10.7, pitch: "F4", duration: 0.3}
      - {time: 11.0, pitch: "E4", duration: 0.3}
      - {time: 11.3, pitch: "F4", duration: 0.6}

      # E-E-E-D-E
      - {time: 12.0, pitch: "E4", duration: 0.8}
      - {time: 12.8, pitch: "E4", duration: 0.3}
      - {time: 13.1, pitch: "E4", duration: 0.3}
      - {time: 13.4, pitch: "D4", duration: 0.3}
      - {time: 13.7, pitch: "E4", duration: 0.6}

  pulse2:
    enabled: true
    duty_cycle: 0.5
    volume: 0.6
    notes:
      # Harmony part (playing intervals)
      - {time: 0.0, pitch: "F4", duration: 0.4}
      - {time: 0.5, pitch: "C5", duration: 0.3}
      - {time: 0.8, pitch: "F4", duration: 0.2}
      - {time: 1.0, pitch: "F4", duration: 0.3}
      - {time: 1.3, pitch: "G4", duration: 0.2}
      - {time: 1.5, pitch: "A4", duration: 0.3}
      - {time: 1.8, pitch: "A#4", duration: 0.6}
      - {time: 4.8, pitch: "F4", duration: 0.8}
      - {time: 5.6, pitch: "F4", duration: 0.6}
      - {time: 6.2, pitch: "E4", duration: 0.3}
      - {time: 6.5, pitch: "F4", duration: 0.6}
      - {time: 7.2, pitch: "D4", duration: 0.8}
      - {time: 8.0, pitch: "D4", duration: 0.6}
      - {time: 8.6, pitch: "C4", duration: 0.3}
      - {time: 8.9, pitch: "D4", duration: 0.6}

  triangle:
    enabled: true
    volume: 0.7
    notes:
      # Strong bass line
      - {time: 0.0, pitch: "A#2", duration: 0.4}
      - {time: 0.4, pitch: "A#2", duration: 0.4}
      - {time: 0.8, pitch: "A#2", duration: 0.4}
      - {time: 1.2, pitch: "A#2", duration: 0.4}
      - {time: 1.6, pitch: "D#3", duration: 0.8}
      - {time: 2.5, pitch: "D#3", duration: 0.4}
      - {time: 2.9, pitch: "D#3", duration: 0.4}
      - {time: 3.3, pitch: "F3", duration: 0.4}
      - {time: 3.7, pitch: "F3", duration: 0.4}
      - {time: 4.1, pitch: "G#3", duration: 0.7}
      - {time: 4.8, pitch: "A#2", duration: 0.4}
      - {time: 5.2, pitch: "A#2", duration: 0.4}
      - {time: 5.6, pitch: "A#2", duration: 0.6}
      - {time: 6.2, pitch: "F2", duration: 0.3}
      - {time: 6.5, pitch: "A#2", duration: 0.6}
      - {time: 7.2, pitch: "G2", duration: 0.4}
      - {time: 7.6, pitch: "G2", duration: 0.4}
      - {time: 8.0, pitch: "G2", duration: 0.6}
      - {time: 8.6, pitch: "D2", duration: 0.3}
      - {time: 8.9, pitch: "G2", duration: 0.6}
      - {time: 9.6, pitch: "F2", duration: 0.4}
      - {time: 10.0, pitch: "F2", duration: 0.4}
      - {time: 10.4, pitch: "F2", duration: 0.6}
      - {time: 11.0, pitch: "C2", duration: 0.3}
      - {time: 11.3, pitch: "F2", duration: 0.6}

  noise:
    enabled: true
    volume: 0.3
    mode: "random"
    notes:
      # Percussion (adventure atmosphere)
      - {time: 0.0, period: 4, duration: 0.08}
      - {time: 0.8, period: 4, duration: 0.08}
      - {time: 1.6, period: 4, duration: 0.08}
      - {time: 2.4, period: 4, duration: 0.08}
      - {time: 3.2, period: 4, duration: 0.08}
      - {time: 4.0, period: 4, duration: 0.08}
      - {time: 4.8, period: 4, duration: 0.08}
      - {time: 5.6, period: 4, duration: 0.08}
      - {time: 6.4, period: 4, duration: 0.08}
      - {time: 7.2, period: 4, duration: 0.08}
      - {time: 8.0, period: 4, duration: 0.08}
      - {time: 8.8, period: 4, duration: 0.08}
      - {time: 9.6, period: 4, duration: 0.08}
      - {time: 10.4, period: 4, duration: 0.08}
      - {time: 11.2, period: 4, duration: 0.08}
      - {time: 12.0, period: 4, duration: 0.08}
