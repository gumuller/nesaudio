# Super Mario Bros - Overworld Theme
# Iconic theme by Koji Kondo
# Re-timed for authentic fast-paced gameplay feel
title: "Super Mario Bros - Overworld Theme"
composer: "Koji Kondo"
tempo: 200
time_signature: "4/4"

channels:
  pulse1:
    enabled: true
    duty_cycle: 0.125
    volume: 0.85
    notes:
      # Opening: E-E-REST-E-REST-C-E-REST-G (fast sixteenth notes)
      - {time: 0.0, pitch: "E5", duration: 0.075}
      - {time: 0.15, pitch: "E5", duration: 0.075}
      - {time: 0.375, pitch: "E5", duration: 0.075}
      - {time: 0.60, pitch: "C5", duration: 0.075}
      - {time: 0.75, pitch: "E5", duration: 0.15}
      - {time: 1.05, pitch: "G5", duration: 0.30}
      - {time: 1.65, pitch: "G4", duration: 0.30}

      # Second phrase: C-G-E (quarter notes with space)
      - {time: 2.25, pitch: "C5", duration: 0.225}
      - {time: 2.70, pitch: "G4", duration: 0.225}
      - {time: 3.15, pitch: "E4", duration: 0.225}

      # A-B-A#-A (eighth notes)
      - {time: 3.60, pitch: "A4", duration: 0.15}
      - {time: 3.825, pitch: "B4", duration: 0.15}
      - {time: 4.05, pitch: "A#4", duration: 0.075}
      - {time: 4.20, pitch: "A4", duration: 0.15}

      # Third phrase: G-E-G-A-F-G (triplet feel)
      - {time: 4.50, pitch: "G4", duration: 0.10}
      - {time: 4.65, pitch: "E5", duration: 0.10}
      - {time: 4.80, pitch: "G5", duration: 0.10}
      - {time: 4.95, pitch: "A5", duration: 0.15}
      - {time: 5.175, pitch: "F5", duration: 0.075}
      - {time: 5.325, pitch: "G5", duration: 0.15}

      # E-C-D-B (descending)
      - {time: 5.625, pitch: "E5", duration: 0.15}
      - {time: 5.85, pitch: "C5", duration: 0.075}
      - {time: 6.0, pitch: "D5", duration: 0.075}
      - {time: 6.15, pitch: "B4", duration: 0.30}

  pulse2:
    enabled: true
    duty_cycle: 0.125
    volume: 0.6
    notes:
      # Harmony (staccato chords)
      - {time: 0.0, pitch: "F#4", duration: 0.075}
      - {time: 0.15, pitch: "F#4", duration: 0.075}
      - {time: 0.375, pitch: "F#4", duration: 0.075}
      - {time: 0.60, pitch: "F#4", duration: 0.075}
      - {time: 0.75, pitch: "F#4", duration: 0.15}
      - {time: 1.05, pitch: "B4", duration: 0.30}
      - {time: 1.65, pitch: "E4", duration: 0.30}
      - {time: 2.25, pitch: "G4", duration: 0.225}
      - {time: 2.70, pitch: "E4", duration: 0.225}
      - {time: 3.15, pitch: "C4", duration: 0.225}
      - {time: 3.60, pitch: "F4", duration: 0.15}
      - {time: 3.825, pitch: "G4", duration: 0.15}
      - {time: 4.05, pitch: "F#4", duration: 0.075}
      - {time: 4.20, pitch: "F4", duration: 0.15}
      - {time: 4.50, pitch: "E4", duration: 0.10}
      - {time: 4.65, pitch: "C5", duration: 0.10}
      - {time: 4.80, pitch: "E5", duration: 0.10}
      - {time: 4.95, pitch: "F5", duration: 0.15}
      - {time: 5.175, pitch: "D5", duration: 0.075}
      - {time: 5.325, pitch: "E5", duration: 0.15}
      - {time: 5.625, pitch: "C5", duration: 0.15}
      - {time: 5.85, pitch: "A4", duration: 0.075}
      - {time: 6.0, pitch: "B4", duration: 0.075}
      - {time: 6.15, pitch: "G4", duration: 0.30}

  triangle:
    enabled: true
    volume: 0.7
    notes:
      # Bouncy bass line (faster, tighter)
      - {time: 0.0, pitch: "D3", duration: 0.15}
      - {time: 0.15, pitch: "D2", duration: 0.15}
      - {time: 0.375, pitch: "D3", duration: 0.15}
      - {time: 0.60, pitch: "D2", duration: 0.15}
      - {time: 1.05, pitch: "G3", duration: 0.15}
      - {time: 1.275, pitch: "G2", duration: 0.15}
      - {time: 1.65, pitch: "G2", duration: 0.30}
      - {time: 2.25, pitch: "C3", duration: 0.15}
      - {time: 2.475, pitch: "C2", duration: 0.15}
      - {time: 2.70, pitch: "G2", duration: 0.15}
      - {time: 2.925, pitch: "G3", duration: 0.15}
      - {time: 3.15, pitch: "C3", duration: 0.15}
      - {time: 3.375, pitch: "C2", duration: 0.15}
      - {time: 3.60, pitch: "F2", duration: 0.15}
      - {time: 3.825, pitch: "F3", duration: 0.15}
      - {time: 4.05, pitch: "F2", duration: 0.15}
      - {time: 4.275, pitch: "F3", duration: 0.15}
      - {time: 4.50, pitch: "C3", duration: 0.15}
      - {time: 4.725, pitch: "C2", duration: 0.15}
      - {time: 4.95, pitch: "C3", duration: 0.15}
      - {time: 5.175, pitch: "F3", duration: 0.15}
      - {time: 5.40, pitch: "F2", duration: 0.15}
      - {time: 5.625, pitch: "F3", duration: 0.15}
      - {time: 5.85, pitch: "C3", duration: 0.075}
      - {time: 6.0, pitch: "A2", duration: 0.075}
      - {time: 6.15, pitch: "B2", duration: 0.075}
      - {time: 6.30, pitch: "G2", duration: 0.30}

  noise:
    enabled: true
    volume: 0.3
    mode: "random"
    notes:
      # Percussion on beats (faster rhythm)
      - {time: 0.0, period: 3, duration: 0.04}
      - {time: 0.375, period: 3, duration: 0.04}
      - {time: 0.75, period: 3, duration: 0.04}
      - {time: 1.125, period: 3, duration: 0.04}
      - {time: 1.50, period: 3, duration: 0.04}
      - {time: 2.25, period: 3, duration: 0.04}
      - {time: 2.70, period: 3, duration: 0.04}
      - {time: 3.15, period: 3, duration: 0.04}
      - {time: 3.60, period: 3, duration: 0.04}
      - {time: 4.05, period: 3, duration: 0.04}
      - {time: 4.50, period: 3, duration: 0.04}
      - {time: 4.95, period: 3, duration: 0.04}
      - {time: 5.40, period: 3, duration: 0.04}
      - {time: 5.85, period: 3, duration: 0.04}
      - {time: 6.30, period: 3, duration: 0.04}
