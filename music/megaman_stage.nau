# Mega Man 2 - Stage Select Theme
# Catchy, upbeat chiptune classic
title: "Mega Man 2 - Stage Select"
composer: "Takashi Tateishi"
tempo: 160
time_signature: "4/4"

channels:
  pulse1:
    enabled: true
    duty_cycle: 0.25
    volume: 0.85
    notes:
      # Opening riff: E-E-F#-G-G-F#-E-D-E
      - {time: 0.0, pitch: "E5", duration: 0.2}
      - {time: 0.2, pitch: "E5", duration: 0.2}
      - {time: 0.4, pitch: "F#5", duration: 0.2}
      - {time: 0.6, pitch: "G5", duration: 0.3}
      - {time: 0.9, pitch: "G5", duration: 0.3}
      - {time: 1.2, pitch: "F#5", duration: 0.2}
      - {time: 1.4, pitch: "E5", duration: 0.2}
      - {time: 1.6, pitch: "D5", duration: 0.2}
      - {time: 1.8, pitch: "E5", duration: 0.6}

      # Second phrase: C-C-D-E-E-D-C-B-C
      - {time: 2.5, pitch: "C5", duration: 0.2}
      - {time: 2.7, pitch: "C5", duration: 0.2}
      - {time: 2.9, pitch: "D5", duration: 0.2}
      - {time: 3.1, pitch: "E5", duration: 0.3}
      - {time: 3.4, pitch: "E5", duration: 0.3}
      - {time: 3.7, pitch: "D5", duration: 0.2}
      - {time: 3.9, pitch: "C5", duration: 0.2}
      - {time: 4.1, pitch: "B4", duration: 0.2}
      - {time: 4.3, pitch: "C5", duration: 0.6}

      # Faster run: A-B-C-D-E-F#-G-A
      - {time: 5.0, pitch: "A4", duration: 0.15}
      - {time: 5.15, pitch: "B4", duration: 0.15}
      - {time: 5.3, pitch: "C5", duration: 0.15}
      - {time: 5.45, pitch: "D5", duration: 0.15}
      - {time: 5.6, pitch: "E5", duration: 0.15}
      - {time: 5.75, pitch: "F#5", duration: 0.15}
      - {time: 5.9, pitch: "G5", duration: 0.15}
      - {time: 6.05, pitch: "A5", duration: 0.4}

      # Return phrase: G-F#-E-D-C-B-A-G
      - {time: 6.5, pitch: "G5", duration: 0.2}
      - {time: 6.7, pitch: "F#5", duration: 0.2}
      - {time: 6.9, pitch: "E5", duration: 0.2}
      - {time: 7.1, pitch: "D5", duration: 0.2}
      - {time: 7.3, pitch: "C5", duration: 0.2}
      - {time: 7.5, pitch: "B4", duration: 0.2}
      - {time: 7.7, pitch: "A4", duration: 0.2}
      - {time: 7.9, pitch: "G4", duration: 0.4}

      # Final phrase: E-E-E-D-E-G
      - {time: 8.4, pitch: "E5", duration: 0.3}
      - {time: 8.7, pitch: "E5", duration: 0.3}
      - {time: 9.0, pitch: "E5", duration: 0.3}
      - {time: 9.3, pitch: "D5", duration: 0.2}
      - {time: 9.5, pitch: "E5", duration: 0.3}
      - {time: 9.8, pitch: "G5", duration: 0.6}

  pulse2:
    enabled: true
    duty_cycle: 0.125
    volume: 0.6
    notes:
      # Counter melody (arpeggios)
      - {time: 0.0, pitch: "C4", duration: 0.15}
      - {time: 0.15, pitch: "E4", duration: 0.15}
      - {time: 0.3, pitch: "G4", duration: 0.15}
      - {time: 0.45, pitch: "C5", duration: 0.15}
      - {time: 0.6, pitch: "G4", duration: 0.15}
      - {time: 0.75, pitch: "E4", duration: 0.15}
      - {time: 0.9, pitch: "C4", duration: 0.15}
      - {time: 1.05, pitch: "E4", duration: 0.15}
      - {time: 1.2, pitch: "G4", duration: 0.15}
      - {time: 1.35, pitch: "E4", duration: 0.15}
      - {time: 1.5, pitch: "C4", duration: 0.15}
      - {time: 1.65, pitch: "E4", duration: 0.15}

      - {time: 2.5, pitch: "A3", duration: 0.15}
      - {time: 2.65, pitch: "C4", duration: 0.15}
      - {time: 2.8, pitch: "E4", duration: 0.15}
      - {time: 2.95, pitch: "A4", duration: 0.15}
      - {time: 3.1, pitch: "E4", duration: 0.15}
      - {time: 3.25, pitch: "C4", duration: 0.15}

      - {time: 5.0, pitch: "D4", duration: 0.3}
      - {time: 5.3, pitch: "F#4", duration: 0.3}
      - {time: 5.6, pitch: "A4", duration: 0.3}
      - {time: 5.9, pitch: "D5", duration: 0.3}

      - {time: 6.5, pitch: "C5", duration: 0.2}
      - {time: 6.7, pitch: "A4", duration: 0.2}
      - {time: 6.9, pitch: "G4", duration: 0.2}
      - {time: 7.1, pitch: "F#4", duration: 0.2}
      - {time: 7.3, pitch: "E4", duration: 0.2}
      - {time: 7.5, pitch: "D4", duration: 0.2}
      - {time: 7.7, pitch: "C4", duration: 0.2}
      - {time: 7.9, pitch: "B3", duration: 0.4}

  triangle:
    enabled: true
    volume: 0.7
    notes:
      # Fast bass line
      - {time: 0.0, pitch: "C2", duration: 0.3}
      - {time: 0.3, pitch: "C3", duration: 0.3}
      - {time: 0.6, pitch: "C2", duration: 0.3}
      - {time: 0.9, pitch: "C3", duration: 0.3}
      - {time: 1.2, pitch: "C2", duration: 0.3}
      - {time: 1.5, pitch: "E2", duration: 0.3}
      - {time: 1.8, pitch: "G2", duration: 0.3}
      - {time: 2.1, pitch: "C3", duration: 0.3}

      - {time: 2.5, pitch: "A2", duration: 0.3}
      - {time: 2.8, pitch: "A2", duration: 0.3}
      - {time: 3.1, pitch: "A2", duration: 0.3}
      - {time: 3.4, pitch: "A2", duration: 0.3}
      - {time: 3.7, pitch: "A2", duration: 0.3}
      - {time: 4.0, pitch: "C3", duration: 0.3}
      - {time: 4.3, pitch: "E3", duration: 0.3}

      - {time: 5.0, pitch: "D2", duration: 0.2}
      - {time: 5.2, pitch: "D3", duration: 0.2}
      - {time: 5.4, pitch: "D2", duration: 0.2}
      - {time: 5.6, pitch: "D3", duration: 0.2}
      - {time: 5.8, pitch: "D2", duration: 0.2}
      - {time: 6.0, pitch: "D3", duration: 0.2}

      - {time: 6.5, pitch: "G2", duration: 0.3}
      - {time: 6.8, pitch: "D3", duration: 0.3}
      - {time: 7.1, pitch: "G2", duration: 0.3}
      - {time: 7.4, pitch: "D3", duration: 0.3}
      - {time: 7.7, pitch: "G2", duration: 0.3}
      - {time: 8.0, pitch: "B2", duration: 0.3}

      - {time: 8.4, pitch: "C2", duration: 0.3}
      - {time: 8.7, pitch: "C3", duration: 0.3}
      - {time: 9.0, pitch: "C2", duration: 0.3}
      - {time: 9.3, pitch: "G2", duration: 0.2}
      - {time: 9.5, pitch: "E2", duration: 0.3}
      - {time: 9.8, pitch: "C3", duration: 0.6}

  noise:
    enabled: true
    volume: 0.3
    mode: "random"
    notes:
      # Steady beat
      - {time: 0.0, period: 2, duration: 0.05}
      - {time: 0.3, period: 2, duration: 0.05}
      - {time: 0.6, period: 2, duration: 0.05}
      - {time: 0.9, period: 2, duration: 0.05}
      - {time: 1.2, period: 2, duration: 0.05}
      - {time: 1.5, period: 2, duration: 0.05}
      - {time: 1.8, period: 2, duration: 0.05}
      - {time: 2.1, period: 2, duration: 0.05}
      - {time: 2.4, period: 2, duration: 0.05}
      - {time: 2.7, period: 2, duration: 0.05}
      - {time: 3.0, period: 2, duration: 0.05}
      - {time: 3.3, period: 2, duration: 0.05}
      - {time: 3.6, period: 2, duration: 0.05}
      - {time: 3.9, period: 2, duration: 0.05}
      - {time: 4.2, period: 2, duration: 0.05}
      - {time: 4.5, period: 2, duration: 0.05}
      - {time: 4.8, period: 2, duration: 0.05}
      - {time: 5.1, period: 2, duration: 0.05}
      - {time: 5.4, period: 2, duration: 0.05}
      - {time: 5.7, period: 2, duration: 0.05}
      - {time: 6.0, period: 2, duration: 0.05}
      - {time: 6.3, period: 2, duration: 0.05}
      - {time: 6.6, period: 2, duration: 0.05}
      - {time: 6.9, period: 2, duration: 0.05}
      - {time: 7.2, period: 2, duration: 0.05}
      - {time: 7.5, period: 2, duration: 0.05}
      - {time: 7.8, period: 2, duration: 0.05}
      - {time: 8.1, period: 2, duration: 0.05}
      - {time: 8.4, period: 2, duration: 0.05}
      - {time: 8.7, period: 2, duration: 0.05}
      - {time: 9.0, period: 2, duration: 0.05}
      - {time: 9.3, period: 2, duration: 0.05}
      - {time: 9.6, period: 2, duration: 0.05}
