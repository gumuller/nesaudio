      - {time: 5.00, pitch: "A5", duration: 0.22}
      - {time: 5.25, pitch: "F5", duration: 0.22}
      - {time: 5.50, pitch: "D5", duration: 0.22}
      - {time: 5.75, pitch: "G5", duration: 0.22}
      # Bar 4
      - {time: 6.00, pitch: "G5", duration: 0.22}
      - {time: 6.25, pitch: "B5", duration: 0.22}
      - {time: 6.50, pitch: "D6", duration: 0.22}
      - {time: 6.75, pitch: "G6", duration: 0.22}
      - {time: 7.00, pitch: "D6", duration: 0.22}
      - {time: 7.25, pitch: "B5", duration: 0.22}
      - {time: 7.50, pitch: "G5", duration: 0.45}

  pulse2:
    enabled: true
    duty_cycle: 0.25
    volume: 0.5
