      # Harmony a third below the melody
      - {time: 0.00, pitch: "E4", duration: 0.45}
      - {time: 0.50, pitch: "C5", duration: 0.45}
      - {time: 1.00, pitch: "E5", duration: 0.45}
      - {time: 1.50, pitch: "G4", duration: 0.45}
      - {time: 2.00, pitch: "G4", duration: 0.45}
      - {time: 2.50, pitch: "D5", duration: 0.45}
      - {time: 3.00, pitch: "G5", duration: 0.45}
      - {time: 3.50, pitch: "A4", duration: 0.45}
      - {time: 4.00, pitch: "F4", duration: 0.45}
