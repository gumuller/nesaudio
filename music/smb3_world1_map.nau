# Super Mario Bros 3 - World 1 Map Theme
# Iconic theme by Koji Kondo
# Chiptune arrangement for NESAUDIO (tempo 120, eighth = 0.25s, 4-bar loop)
title: "Super Mario Bros 3 - World 1 Map"
composer: "Koji Kondo"
tempo: 120
time_signature: "4/4"
duration: 8.0

channels:
  pulse1:
    enabled: true
    duty_cycle: 0.5
    volume: 0.8
    notes:
      # Bar 1
      - {time: 0.00, pitch: "C5", duration: 0.22}
      - {time: 0.25, pitch: "E5", duration: 0.22}
      - {time: 0.50, pitch: "G5", duration: 0.22}
      - {time: 0.75, pitch: "C6", duration: 0.22}
